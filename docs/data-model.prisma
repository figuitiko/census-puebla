// =============================================================================
// Padron Puebla - slim MVP data model (PLANNING DRAFT, not wired to the app)
// Final location at implementation: prisma/schema.prisma (Phase 1 of the backlog)
//
// Conventions
//  - Prisma 7: generator "prisma-client" (requires an explicit `output`), pinned 7.x
//    stable for prisma + @prisma/client (never `latest` = 8 RC), driver adapter
//    @prisma/adapter-pg. The connection URL is NOT in this file: Prisma 7 reads it
//    from prisma.config.ts (datasource.url = env("DATABASE_URL")).
//  - null = unknown / not captured. 0 = confirmed absence. Never mix them.
//  - Better Auth tables (session, account, verification, and the base `user`
//    columns) are generated LATER by the Better Auth CLI. The `role` column on User
//    mirrors the Role enum below (Better Auth `additionalFields`, input: false).
//  - Cedula field numbers (1-26) refer to the workbook
//    Cedula_levantamiento_unidades_habitacionales_Puebla_ajustada.xlsx
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma" // required in Prisma 7; adjust at wiring time
}

datasource db {
  provider = "postgresql"
  // url lives in prisma.config.ts (Prisma 7)
}

// ----------------------------- Enums: access & flow --------------------------

enum Role {
  ADMIN
  COORDINADOR
  ENCUESTADOR
  VISOR
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum ReviewDecision {
  APPROVED
  RETURNED
}

enum EvidenceKind {
  PHOTO
  DOCUMENT
}

enum EvidenceStatus {
  PENDING // row created, upload not yet verified
  CONFIRMED // verified server-side (Blob head()), counts as a valid photo
}

// Fields 11, 13, 19: Si / No / No fue posible determinar
// (fields 9 and 23 are plain Boolean: workbook allows Si/No only)
enum TriState {
  YES
  NO
  UNDETERMINED
}

// ------------------------- Enums: workbook catalogs (Catalogos) ---------------

// Catalogos col C (field 12 breakdown). Viviendas are NEVER part of this (Instrucciones A5).
enum PrivateUnitType {
  LOCAL_COMERCIAL
  OFICINAS
  CONSULTORIOS
  OTROS
}

// Catalogos col D (field 15)
enum GreenAreaType {
  JARDIN
  PARQUE
  CAMELLON
  OTRA_AREA_VERDE
}

// Catalogos col E (field 16)
enum GreenAreaUse {
  RECREACION
  DESCANSO_CONVIVENCIA
  JUEGO_INFANTIL
  ACTIVIDAD_FISICA_DEPORTIVA
  ORNAMENTAL
  CONSERVACION_AMBIENTAL
  OTRO
}

// Catalogos col F (field 17, multi-select per Instrucciones A6)
enum Equipment {
  NINGUNO
  BANCAS_MOBILIARIO_DESCANSO
  JUEGOS_INFANTILES
  EQUIPAMIENTO_DEPORTIVO
  SENDEROS
  OTRO
}

// Catalogos col G (field 18)
enum GreenAreaCondition {
  BUENA
  REGULAR
  DEFICIENTE
  NO_FUE_POSIBLE_VALORAR
}

// Catalogos H2:H5 (field 20, multi-select). NOT the source list the workbook DV on B33 wrongly uses.
enum OrganizationFigure {
  ADMINISTRADOR
  COMITE_ADMINISTRACION
  MESA_DIRECTIVA
  OTRA
}

// Catalogos col I (field 22)
enum InfoSource {
  ADMINISTRADOR
  COMITE_O_MESA_DIRECTIVA
  PERSONA_RESIDENTE
  DOCUMENTO_DISPONIBLE
  REGISTRO_MUNICIPIO
  OBSERVACION_DIRECTA
  OTRA
}

// Catalogos col B "Calidad dato" is referenced by no validation: deferred, not modeled.

// ----------------------------------- Models -----------------------------------

/// Better Auth `user` table + our columns. Other auth tables are generated by its CLI.
model User {
  id        String   @id
  name      String
  email     String   @unique
  role      Role     @default(ENCUESTADOR) // mirrors the Role enum
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedUnits CampaignUnit[]     @relation("UnitAssignee")
  submissions   CensusSubmission[] @relation("SubmissionAuthor")
  reviews       Review[]

  // Better Auth CLI adds: emailVerified, image, sessions[], accounts[]
}

model Campaign {
  id           String   @id @default(cuid())
  name         String
  municipality String
  startsOn     DateTime @db.Date
  endsOn       DateTime @db.Date
  timezone     String   @default("America/Mexico_City")
  minPhotos    Int      @default(10) // valid photos required per located unit
  createdAt    DateTime @default(now())

  units CampaignUnit[]
}

model HousingComplex {
  id          String   @id @default(cuid())
  name        String // field 5
  address     String? // field 8
  juntaAuxiliar String? // field 6: free text until the municipality gives a catalog
  colonia     String? // field 7: free text until the municipality gives a catalog
  // field 4: typed manually by the encuestador (no device GPS), range-validated in the app
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  createdAt   DateTime @default(now())

  units CampaignUnit[]

  @@index([name, colonia]) // soft duplicate guard only, not unique
}

/// A complex inside a campaign. Folds assignment and planning (no Visit table in MVP).
model CampaignUnit {
  id           String    @id @default(cuid())
  campaignId   String
  complexId    String
  folio        String // field 1, unique per campaign
  inScope      Boolean   @default(true) // false = discovered during fieldwork
  assignedToId String?
  plannedDate  DateTime? @db.Date

  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  complex    HousingComplex    @relation(fields: [complexId], references: [id], onDelete: Restrict)
  assignedTo User?             @relation("UnitAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  submission CensusSubmission?

  @@unique([campaignId, complexId])
  @@unique([campaignId, folio])
  @@index([assignedToId])
}

/// One mutable cedula per unit. `version` = optimistic lock. Review rows keep the comment trail.
model CensusSubmission {
  id       String           @id @default(cuid())
  unitId   String           @unique
  authorId String
  status   SubmissionStatus @default(DRAFT)
  version  Int              @default(1)

  visitedAt DateTime? // field 2
  located   Boolean? // field 9 (Si/No). false => only section A, field 26 and photos required

  dwellings          Int? // field 10 (null = unknown)
  otherUnits         TriState? // field 11
  // field 12 total is DERIVED: 0 if otherUnits = NO, null if any count is null. Never stored.

  greenAreas         TriState? // field 13
  greenAreaCount     Int? // field 14
  greenType          GreenAreaType? // field 15
  greenUse           GreenAreaUse? // field 16
  greenCondition     GreenAreaCondition? // field 18

  orgIdentified      TriState? // field 19
  orgNotes           String? // field 21

  source             InfoSource? // field 22
  hasDocEvidence     Boolean? // field 23 (Si/No)
  docType            String? // field 24 (free text, "[Especifique]")
  observations       String? // field 26

  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  unit       CampaignUnit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  author     User                 @relation("SubmissionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  privateUnits PrivateUnitCount[]
  equipment  EquipmentSelection[]
  orgFigures OrganizationSelection[]
  evidence   Evidence[]
  reviews    Review[]

  @@index([status])
  @@index([authorId])
}

/// Field 12 rows. quantity null = unknown, 0 = confirmed none. Never contains viviendas.
model PrivateUnitCount {
  id           String          @id @default(cuid())
  submissionId String
  type         PrivateUnitType
  quantity     Int?
  otherLabel   String? // only for OTROS

  submission CensusSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, type])
}

/// Field 17 (multi-select)
model EquipmentSelection {
  id           String    @id @default(cuid())
  submissionId String
  equipment    Equipment

  submission CensusSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, equipment])
}

/// Field 20 (multi-select, catalog H2:H5)
model OrganizationSelection {
  id           String             @id @default(cuid())
  submissionId String
  figure       OrganizationFigure

  submission CensusSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, figure])
}

/// Field 25 photos + field 24 documents. Photos arrive already georeferenced; the system
/// does NOT read EXIF nor store photo coordinates, accuracy or geo provenance.
/// A "valid photo" = status CONFIRMED (unique pathname, verified via Blob head()).
model Evidence {
  id           String         @id @default(cuid())
  submissionId String
  kind         EvidenceKind   @default(PHOTO)
  pathname     String         @unique // private Blob pathname; idempotency key for confirm
  contentType  String
  size         Int
  caption      String?
  status       EvidenceStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  submission CensusSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, status])
}

model Review {
  id           String         @id @default(cuid())
  submissionId String
  reviewerId   String
  decision     ReviewDecision
  comment      String? // REQUIRED when decision = RETURNED (enforced in the action)
  createdAt    DateTime       @default(now())

  submission CensusSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User             @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId])
}
